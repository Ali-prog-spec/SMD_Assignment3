<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
    android:id="@+id/main"
        android:background="#FFFFFF">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header with back button, username and menu -->
                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="#FFFFFF"
                        android:elevation="1dp">

                        <ImageView
                                android:id="@+id/back_button"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/back_icon"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:padding="4dp"
                                android:contentDescription="Back" />

                        <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/username2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="kyan.coleman"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="#262626" />

                                <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/verified_icon"
                                        android:layout_marginStart="4dp" />

                        </LinearLayout>

                        <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/tripple_dot"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:padding="4dp"
                                android:contentDescription="Menu" />

                </RelativeLayout>

                <!-- Profile Info Section -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Profile Picture and Stats Row -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="16dp">

                                <!-- Profile Picture -->
                                <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/profile_image"
                                        android:layout_width="86dp"
                                        android:layout_height="86dp"
                                        android:layout_marginEnd="28dp"
                                        android:src="@drawable/dp6" />

                                <!-- Stats Container -->
                                <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="horizontal"
                                        android:layout_gravity="center_vertical">

                                        <!-- Posts Count -->
                                        <LinearLayout

                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical"
                                                android:gravity="center">

                                                <TextView
                                                    android:id="@+id/postCount"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="161"
                                                        android:textSize="18sp"
                                                        android:textStyle="bold"
                                                        android:textColor="#262626" />

                                                <TextView
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="posts"
                                                        android:textSize="13sp"
                                                        android:textColor="#262626"
                                                        android:layout_marginTop="2dp" />

                                        </LinearLayout>

                                        <!-- Followers Count -->
                                        <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical"
                                                android:gravity="center">

                                                <TextView
                                                    android:id="@+id/followersCount"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="112K"
                                                        android:textSize="18sp"
                                                        android:textStyle="bold"
                                                        android:textColor="#262626" />

                                                <TextView
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="followers"
                                                        android:textSize="13sp"
                                                        android:textColor="#262626"
                                                        android:layout_marginTop="2dp" />

                                        </LinearLayout>

                                        <!-- Following Count -->
                                        <LinearLayout
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:orientation="vertical"
                                                android:gravity="center">

                                                <TextView
                                                    android:id="@+id/followingCount"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="162"
                                                        android:textSize="18sp"
                                                        android:textStyle="bold"
                                                        android:textColor="#262626" />

                                                <TextView
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="following"
                                                        android:textSize="13sp"
                                                        android:textColor="#262626"
                                                        android:layout_marginTop="2dp" />

                                        </LinearLayout>

                                </LinearLayout>

                        </LinearLayout>

                        <!-- Bio Section -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">

                                <TextView
                                    android:id="@+id/username"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Kyan Coleman"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="#262626"
                                        android:layout_marginBottom="2dp" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🎬 kyam.coleman"
                                        android:textSize="14sp"
                                        android:textColor="#262626"
                                        android:layout_marginBottom="4dp" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Blogger"
                                        android:textSize="14sp"
                                        android:textColor="#262626"
                                        android:layout_marginBottom="4dp" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="A trip to Gilgit is a breathtaking journey through towering mountains, lush valleys, and the mighty Indus River.
                                        You experience serene landscapes, crystal-clear lakes, and the warm culture of the locals.It’s a perfect mix of adventure, peace, and natural beauty."
                                        android:textSize="14sp"
                                        android:textColor="#262626"
                                        android:lineSpacingExtra="2dp"
                                        android:layout_marginBottom="4dp" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="❤ 5 years old"
                                        android:textSize="14sp"
                                        android:textColor="#262626" />

                        </LinearLayout>

                        <!-- Followed by friends section -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="16dp">

                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="16dp"
                                                android:layout_height="16dp"
                                                android:src="@drawable/dp8"
                                                android:layout_marginEnd="-4dp" />

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="16dp"
                                                android:layout_height="16dp"
                                                android:src="@drawable/dp3"
                                                android:layout_marginEnd="-4dp" />

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="16dp"
                                                android:layout_height="16dp"
                                                android:src="@drawable/dp2" />

                                </LinearLayout>

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Followed by your friend, another friend and 297 others"
                                        android:textSize="12sp"
                                        android:textColor="#8E8E8E"
                                        android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Action Buttons -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="16dp">

                                <TextView
                                        android:id="@+id/follow"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:text="Follow"
                                        android:background="@drawable/grey_rect"
                                        android:backgroundTint="@color/light_golden"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginEnd="4dp"
                                        android:gravity="center"
                                        />

                                <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="32dp"
                                        android:layout_weight="1"
                                        android:text="Message"
                                        android:background="@drawable/grey_rect"
                                    android:id="@+id/message"
                                    android:clickable="true"
                                    android:focusable="true"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="#262626"
                                        android:layout_marginStart="4dp"
                                        android:layout_marginEnd="4dp"
                                        android:gravity="center"
                                        />

                                <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="32dp"
                                        android:layout_weight="1"
                                        android:text="Email"
                                        android:textSize="14sp"
                                        android:background="@drawable/grey_rect"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginStart="4dp"
                                        android:layout_marginEnd="4dp"
                                        android:gravity="center"
                                        />

                                <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/people"
                                        android:background="@drawable/grey_rect"
                                        android:padding="6dp"
                                        android:layout_marginStart="4dp" />

                        </LinearLayout>

                </LinearLayout>

                <!-- Story Highlights Section -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="12dp">

                                <!-- Highlight 1 -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginEnd="16dp">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="64dp"
                                                android:layout_height="64dp"
                                                android:src="@drawable/im3" />

                                        <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Highlight 1"
                                                android:textSize="12sp"
                                                android:textColor="#262626"
                                                android:layout_marginTop="4dp" />

                                </LinearLayout>

                                <!-- Highlight 2 -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginEnd="16dp">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="64dp"
                                                android:layout_height="64dp"
                                                android:src="@drawable/im4" />

                                        <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Highlight 2"
                                                android:textSize="12sp"
                                                android:textColor="#262626"
                                                android:layout_marginTop="4dp" />

                                </LinearLayout>

                                <!-- Highlight 3 -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center"
                                        android:layout_marginEnd="16dp">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                                android:layout_width="64dp"
                                                android:layout_height="64dp"
                                                android:src="@drawable/im5" />

                                        <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Highlight 3"
                                                android:textSize="12sp"
                                                android:textColor="#262626"
                                                android:layout_marginTop="4dp" />

                                </LinearLayout>


                                <!-- New Highlight -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:gravity="center">

                                        <FrameLayout
                                                android:layout_width="64dp"
                                                android:layout_height="64dp">

                                                <!-- Circle background -->
                                                <ImageView
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:src="@drawable/circle"
                                                        android:scaleType="centerCrop"/>

                                                <!-- Plus icon -->
                                                <ImageView
                                                        android:layout_width="24dp"
                                                        android:layout_height="24dp"
                                                        android:src="@drawable/plus_icon"
                                                        android:layout_gravity="center"
                                                        app:tint="@color/black"/>
                                        </FrameLayout>


                                        <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="New"
                                                android:textSize="12sp"
                                                android:textColor="#262626"
                                                android:layout_marginTop="4dp" />

                                </LinearLayout>

                        </LinearLayout>

                </LinearLayout>

                <!-- Tab Layout -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:background="#FFFFFF"
                        android:elevation="0.5dp">

                        <!-- Grid Tab -->
                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:background="?android:attr/selectableItemBackground">

                                <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/grid_icon"
                                        app:tint="@color/black"
                                        android:contentDescription="Grid view" />
                                <View
                                        android:layout_width="match_parent"
                                        android:layout_height="2dp"
                                        android:background="@color/black"
                                        android:layout_marginTop="4dp"
                                        />

                        </LinearLayout>

                        <!-- Tagged Tab -->
                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:background="?android:attr/selectableItemBackground">

                                <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/tag"
                                        app:tint="@color/black"
                                        android:contentDescription="Tagged photos" />


                        </LinearLayout>

                </LinearLayout>

                <!-- Photo Grid -->
                <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="false"
                        android:layout_marginTop="1dp">

                        <!-- Row 1 -->
                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="200dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im3"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="200dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im5"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="200dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im7"
                                android:layout_margin="1dp" />

                        <!-- Row 2 -->

                </GridLayout>

        </LinearLayout>

</ScrollView>