<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Story Image -->
    <ImageView
        android:id="@+id/reel_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Touch Zones - Left side (Previous) -->
    <View
        android:id="@+id/touch_left"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="@android:color/transparent" />

    <!-- Touch Zones - Right side (Next) -->
    <View
        android:id="@+id/touch_right"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="@android:color/transparent" />

    <!-- Top User Info Background -->
    <View
        android:id="@+id/top_gradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:background="@color/transparent_black_more" />

    <!-- Progress Bar Container - MUST BE ABOVE top_info -->
    <LinearLayout
        android:id="@+id/storyProgressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:layout_alignParentTop="true"
        android:elevation="10dp" />

    <!-- Top User Info -->
    <RelativeLayout
        android:id="@+id/top_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:layout_below="@id/storyProgressContainer"
        android:layout_alignParentTop="true"
        android:elevation="10dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/reel_dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/default_user" />

        <TextView
            android:id="@+id/reel_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/reel_dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btn_add_story"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/btn_close"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_input_add"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </RelativeLayout>

</RelativeLayout>