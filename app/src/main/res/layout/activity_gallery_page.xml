<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Main Camera Preview Area -->
        <RelativeLayout
                android:id="@+id/camera_preview_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_above="@+id/gallery_section"
                android:layout_alignParentTop="true">

                <!-- Camera Preview Image -->
                <ImageView
                        android:id="@+id/camera_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/im2" />

                <!-- Top Header -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_alignParentTop="true"
                        android:orientation="horizontal"
                        android:background="#4D000000"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cancel"
                                android:textSize="16sp"
                                android:textColor="@color/dark_brown"
                                android:background="?android:attr/selectableItemBackground"
                                android:padding="8dp"
                                android:textStyle="bold"
                                />

                        <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                        <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Recents"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/dark_brown"
                                        android:background="?android:attr/selectableItemBackground"
                                        android:padding="8dp"

                                        />

                                <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/down_icon"
                                        app:tint="@color/dark_brown" />

                        </LinearLayout>

                        <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/dark_brown"
                                android:background="?android:attr/selectableItemBackground"
                                android:padding="8dp"

                                />

                </LinearLayout>

                <!-- Camera Controls Overlay -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_alignParentBottom="true"
                        android:orientation="horizontal"
                        android:background="@color/transparent_black"
                        android:gravity="center_vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp">

                        <!-- Loop Icon -->

                        <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                        <!-- Gallery Icon -->
                        <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/infinity_icon"
                                android:background="@drawable/rounded_black_bg"
                                android:padding="6dp"
                                android:layout_marginStart="16dp"
                                app:tint="@color/white"

                                />
                        <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/staggred_layout"
                                android:background="@drawable/rounded_black_bg"
                                android:padding="6dp"
                                android:layout_marginStart="16dp"

                                app:tint="@color/white"
                                />

                        <!-- Select Multiple Button -->
                        <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="@drawable/rounded_black_bg"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_marginStart="16dp">

                                <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/copy_icon"
                                        android:layout_marginEnd="6dp"
                                        app:tint="@color/white"
                                        />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SELECT MULTIPLE"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF" />

                        </LinearLayout>

                </LinearLayout>

        </RelativeLayout>

        <!-- Gallery Section -->


                <!-- Gallery Grid -->
                <ScrollView
                        android:id="@+id/gallery_section"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_above="@+id/bottom_nav"
                        >

                <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="false"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginTop="2dp">

                        <!-- Row 1 -->
                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im1"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im2"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im3"
                                android:layout_margin="1dp" />

                        <!-- Row 2 -->
                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im4"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im5"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im6"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im7"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im8"
                                android:layout_margin="1dp" />

                        <ImageView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im9"
                                android:layout_margin="1dp" />

                </GridLayout>
                </ScrollView>


                <LinearLayout
                        android:id="@+id/bottom_nav"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/white"
                        android:padding="20dp"
                        android:layout_above="@+id/bar"
                        >
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Library"
                                android:textSize="20sp"
                                android:textColor="@color/dark_brown"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:gravity="center"

                                />
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Photo"
                                android:textSize="20sp"
                                android:textColor="@color/dark_brown"
                                android:layout_weight="1"
                                android:gravity="center"
                                />
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Video"
                                android:textSize="20sp"
                                android:textColor="@color/dark_brown"
                                android:layout_weight="1"
                                android:gravity="center"
                                />
                </LinearLayout>
        <View
                android:id="@+id/bar"
                android:layout_width="200dp"
                android:layout_height="6dp"
                android:background="@color/dark_brown"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="10dp"
                android:layout_centerHorizontal="true"
                >

        </View>
                        <!-- Video Tab -->

</RelativeLayout>