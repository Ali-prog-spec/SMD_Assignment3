            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".UI.incoming_call"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".UI.search_page"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".UI.Search_screen"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".UI.View_profile"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".UI.login_page"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".UI.initial_login_page"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".UI.sign_up"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".UI.liked_you"
            android:exported="false"
